  "fixed_sql": [
    {
      "name": "sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"day_key\" INTEGER NOT NULL UNIQUE, \"note\" TEXT NULL, \"duration_min\" INTEGER NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "muscle_groups",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"muscle_groups\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"slug\" TEXT NULL UNIQUE, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"hidden\" INTEGER NOT NULL DEFAULT 0 CHECK (\"hidden\" IN (0, 1)), \"is_custom\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_custom\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "session_groups",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"session_groups\" (\"session_id\" INTEGER NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"group_id\" INTEGER NOT NULL REFERENCES muscle_groups (id) ON DELETE CASCADE, PRIMARY KEY (\"session_id\", \"group_id\"));"
        }
      ]
    },
    {
      "name": "exercises",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exercises\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"group_id\" INTEGER NULL REFERENCES muscle_groups (id) ON DELETE SET NULL, \"kind\" INTEGER NOT NULL, \"hidden\" INTEGER NOT NULL DEFAULT 0 CHECK (\"hidden\" IN (0, 1)), \"is_custom\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_custom\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "session_exercises",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"session_exercises\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"session_id\" INTEGER NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"exercise_id\" INTEGER NOT NULL REFERENCES exercises (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"note\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "exercise_sets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exercise_sets\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"session_exercise_id\" INTEGER NOT NULL REFERENCES session_exercises (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"weight_kg\" REAL NULL, \"reps\" INTEGER NULL, \"duration_sec\" INTEGER NULL, \"distance_km\" REAL NULL);"
        }
      ]
    },
    {
      "name": "body_weights",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"body_weights\" (\"day_key\" INTEGER NOT NULL, \"weight_kg\" REAL NOT NULL, \"recorded_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"day_key\"));"
        }
      ]
